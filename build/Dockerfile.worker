FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY . .

ENV GOTOOLCHAIN=auto

RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -o garuda-worker ./cmd/garuda-worker

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /app/garuda-worker .

CMD ["./garuda-worker"]