# Keep scripts LF so they run on every platform, even when checked out on Windows
# (CRLF in a .sh file breaks bash with "$'\r': command not found").
*.sh      text eol=lf
*.bash    text eol=lf
*.ps1     text eol=lf
*.go      text eol=lf
*.sql     text eol=lf
Dockerfile* text eol=lf
Makefile  text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.mp4 binary

# Git archive exclusions to keep source tarballs lean (<10 MB) and free of recursive artifacts
dist/** export-ignore
/dist export-ignore
bin/** export-ignore
/bin export-ignore
.garuda/** export-ignore
/.garuda export-ignore
refund-api/refund-api export-ignore
refund-api/bin/** export-ignore
test/benchmark/results/** export-ignore
install_garuda_*.sh export-ignore
install_garuda_*.bash export-ignore
update_garuda_*.sh export-ignore
