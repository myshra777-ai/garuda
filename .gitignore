# Garuda .gitignore
#
# Rules are deliberately specific. There are NO global "*.json", "*.txt" or "*.html" rules:
# a global *.json rule once hid the plugin and MCP-registry manifests (.mcp.json, server.json,
# glama.json, .claude-plugin/, .codex-plugin/, ...) from git, so they never reached GitHub.
# Check a suspicious file with:  git check-ignore -v <path>

# ---- Build output ---------------------------------------------------------
/bin/
/dist/
/garuda
/garuda-api
/garuda-mcp
/garuda-talon
/garuda-worker
/garuda-slack
/telemetry-collector
/migrate
/refund-api/refund-api
/refund-api/bin/
*.exe
*.test
*.prof
coverage.out
coverage.html
c.out

# ---- Release archives (built under /dist; never committed) ----------------
/*.tar.gz
/*.zip
/*.deb
/*.rpm
/install_garuda_*.sh
/install_garuda_*.bash
/update_garuda_*.sh
/sync*.sh

# ---- Local run state and secrets ------------------------------------------
.env
.env.*
!.env.example
.garuda/
.claude/settings.local.json
.claude/worktrees/
*.db
*.sqlite
*.sqlite3
*.log
*.tmp
*.tmp.*
*.bak
*.sql.bak

# ---- Reports and scratch files written by Garuda commands and scripts ----
/garuda.sarif
/garuda-pr-report.md
/benchmark_v2_results/
/benchmark_v2_telemetry.csv
/analyzer_diagnosis.txt
garuda_graph_*.html
garuda_audit_*.txt
garuda_snapshot_*.txt
garuda_truth_index_*.md
docs/truth_index_latest.md
test/benchmark/results/
test_workspace/
garuda-sync/
/tmp/
/docs/api/
garuda_video_build/
internal/api/bad_violation.go

# ---- Internal planning documents: kept on the maintainer's machine only ---
ROADMAP_INTERNAL.md
COMPETITIVE_ANALYSIS.md
GAP_ANALYSIS.md
YC_APPLICATION_NOTES.md
*.private.md
docs/ROADMAP.md
docs/roadmaps/
docs/multi-tenant-roadmap.md
docs/archive/
docs/TRACKING.md
docs/specs/README.md
docs/specs/tenant-tabs.md
garuda_Roadmap_tracking.md
garuda_autonomy_Queue_plan.md
DOCS/VISION.md

# ---- Editors and OS -------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Language tooling -----------------------------------------------------
/vendor/
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
/venv/
/env/
/ENV/

# ---- Infrastructure -------------------------------------------------------
*.tfstate
*.tfstate.*
.terraform/
*.kubeconfig
docker-compose.override.yml
/docker-compose.garuda.yml
scan_reports/
audit-report/
diagnose-out/
test-results/
benchmark_report.json
garuda-snapshot.json
docs/generated/
.claude/
/mcp.json
/mcp-registry.json
/plugin.json
.cursor/mcp.json
scripts/eval_harness/*.json
