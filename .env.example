# Example environment file for Garuda
# Copy to .env and fill with secure values (DO NOT commit .env)

# Database
POSTGRES_USER=garuda
POSTGRES_PASSWORD=change-me-secure
DATABASE_URL=postgres://garuda:${POSTGRES_PASSWORD}@localhost:5432/garuda?sslmode=disable

# App
GARUDA_ENV=production
JWT_SECRET=change-me-very-secure
REDIS_ADDR=redis:6379

# Telemetry / External keys
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local overrides
# POSTGRES_PASSWORD_LOCAL=test
