CREATE TABLE IF NOT EXISTS harvested_decisions (
    id UUID PRIMARY KEY,
    source_type TEXT NOT NULL,
    source_id TEXT NOT NULL,
    source_url TEXT,
    raw_text TEXT NOT NULL,
    extracted_decision TEXT,
    confidence FLOAT,
    human_validated BOOLEAN DEFAULT FALSE,
    decision_id TEXT REFERENCES decisions(id),  -- Changed to TEXT
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_harvested_source ON harvested_decisions(source_type, source_id);
CREATE INDEX IF NOT EXISTS idx_harvested_confidence ON harvested_decisions(confidence);
CREATE INDEX IF NOT EXISTS idx_harvested_validated ON harvested_decisions(human_validated);